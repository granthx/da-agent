# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
# Any tool-calling model listed at https://console.groq.com/docs/models
# Chinese open models on Groq: Qwen (Alibaba) or Kimi K2 (Moonshot). Check the exact ID there.
GROQ_MODEL=qwen/qwen3-32b
MAX_TOOL_STEPS=8
ALLOW_PYTHON_TOOL=1
